# ============================================================================
#  STAGING .htaccess  —  upload to the staging folder and RENAME to ".htaccess"
#  Do NOT use the production .htaccess here: its Step 0 hardcodes czechalert.com
#  and would 301-redirect all staging traffic to production.
# ============================================================================

# ─── Clean URLs ─────────────────────────────────────────────────────────────
RewriteEngine On
RewriteBase /

# Step 0 — Force HTTPS only (stays on the CURRENT host, e.g. staging.czechalert.com).
# Uses %{HTTP_HOST} instead of a hardcoded domain so staging never bounces to prod.
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Step 1 — 301 redirect: strip .html from browser-facing URLs
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?#] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Step 2 — Internal rewrite: serve /page or /cs/page as /page.html or /cs/page.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ $1.html [L]
# ─────────────────────────────────────────────────────────────────────────────

# Keep staging OUT of search engines (belt-and-braces with robots.txt)
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Disable caching for HTML (force revalidation so colleagues always see latest)
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Short TTL for CSS/JS while you iterate (1 hour)
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# Long TTL for images/fonts
<FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Long TTL for videos (case-insensitive, includes .ogv)
<FilesMatch "(?i)\.(mp4|webm|ogv)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Security headers
Header always set X-Frame-Options "SAMEORIGIN"
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
# NOTE: HSTS intentionally omitted on staging to avoid pinning the subdomain to HTTPS
#       in colleagues' browsers longer than you want during testing.
