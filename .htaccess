# ─── Clean URLs ────────────────────────────────────────────────────────────────
# LiteSpeed Web Server (LSWS) is fully compatible with Apache mod_rewrite.
# Two-step strategy:
#   1. 301 redirect: any request that still includes .html in the URL is permanently
#      redirected to the clean (extensionless) version so search engines consolidate
#      link equity and bookmarks/indexed URLs are corrected automatically.
#   2. Internal rewrite: an extensionless request is transparently served from the
#      matching .html file on disk — the browser never sees the extension.

RewriteEngine On
RewriteBase /

# Step 1 — 301 redirect: strip .html from browser-facing URLs
# Inspects THE_REQUEST (the raw HTTP request line, e.g. "GET /contact.html HTTP/1.1")
# rather than REQUEST_URI so that query strings and hashes don't affect the match.
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?#] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Step 2 — Internal rewrite: serve /page or /cs/page as /page.html or /cs/page.html
# Only fires when the request has no dot in the path (ruling out real assets like
# .css, .js, .png, .php) and the path is neither an existing file nor a directory.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ $1.html [L]
# ───────────────────────────────────────────────────────────────────────────────

# Disable caching for HTML (force revalidation)
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Short TTL for CSS/JS while you deploy (1 hour)
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# Long TTL for images/fonts (safe to cache)
<FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Even longer TTL for videos (safe to cache)
# Case-insensitive match and includes .ogv
<FilesMatch "(?i)\.(mp4|webm|ogv)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HSTS (forces User agent to use HTTPS )
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# X Frame options (protects against framing attacks like clickjacking)
Header always set X-Frame-Options "SAMEORIGIN"

# X Content type options (protection against MIME sniff the content type)
Header always set X-Content-Type-Options "nosniff"

# Referrer policy (Disables browser from sending sensitive informations inside URL to 3rd parties)
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions policy (Disables 3rd parties from accesing extensive sensitive features)
Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), battery=(), bluetooth=(), display-capture=(), document-domain=(), idle-detection=(), midi=(), nfc=(), picture-in-picture=(self), screen-wake-lock=(), serial=(), speaker-selection=(), sync-xhr=(), web-share=(self), xr-spatial-tracking=()"


