# Disable caching for HTML (force revalidation)
<FilesMatch "\.(html|htm)$">
  Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  Header set Pragma "no-cache"
  Header set Expires "0"
</FilesMatch>

# Short TTL for CSS/JS while you deploy (1 hour)
<FilesMatch "\.(css|js)$">
  Header set Cache-Control "public, max-age=3600, must-revalidate"
</FilesMatch>

# Long TTL for images/fonts (safe to cache)
<FilesMatch "\.(png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# Even longer TTL for videos (safe to cache)
# Case-insensitive match and includes .ogv
<FilesMatch "(?i)\.(mp4|webm|ogv)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# HSTS (forces User agent to use HTTPS )
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# X Frame options (protects against framing attacks like clickjacking)
Header always set X-Frame-Options "SAMEORIGIN"

# X Content type options (protection against MIME sniff the content type)
Header always set X-Content-Type-Options "nosniff"

# Referrer policy (Disables browser from sending sensitive informations inside URL to 3rd parties)
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# Permissions policy (Disables 3rd parties from accesing extensive sensitive features)
Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), ambient-light-sensor=(), battery=(), bluetooth=(), display-capture=(), document-domain=(), idle-detection=(), midi=(), nfc=(), picture-in-picture=(self), screen-wake-lock=(), serial=(), speaker-selection=(), sync-xhr=(), web-share=(self), xr-spatial-tracking=()"


