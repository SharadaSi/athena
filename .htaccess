# ============================================================================
# Production Apache/LiteSpeed configuration for https://czechalert.com
# ============================================================================

# Clean URLs
RewriteEngine On
RewriteBase /

# Canonical origin: force HTTPS and the non-www production host in one redirect.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^czechalert\.com$ [NC]
RewriteRule ^ https://czechalert.com%{REQUEST_URI} [R=301,L,NE]

# Redirect browser requests for *.html to their extensionless canonical URL.
RewriteCond %{THE_REQUEST} \s/+(.*?)\.html[\s?#] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# Internally serve extensionless paths from their matching HTML files.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^.]+)$ $1.html [L]

<IfModule mod_headers.c>
  # HTML must revalidate so deployments are visible without disabling caching.
  <FilesMatch "\.(html?|xml|txt)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # CSS and JavaScript filenames are not consistently content-hashed yet.
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>

  # Versioned media and font assets can be cached long-term.
  <FilesMatch "(?i)\.(avif|gif|ico|jpe?g|png|svg|webp|eot|otf|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "(?i)\.(mp4|ogv|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Production security headers. HSTS intentionally excludes subdomains so a
  # non-HTTPS staging subdomain cannot be pinned by the production site.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "accelerometer=(), ambient-light-sensor=(), battery=(), bluetooth=(), camera=(), display-capture=(), document-domain=(), geolocation=(), gyroscope=(), idle-detection=(), magnetometer=(), microphone=(), midi=(), nfc=(), payment=(), picture-in-picture=(self), screen-wake-lock=(), serial=(), speaker-selection=(), sync-xhr=(), usb=(), web-share=(self), xr-spatial-tracking=()"
</IfModule>
