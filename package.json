{
  "name": "czech-alert-website",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "compile:sass": "sass sass/main.scss css/style.css -w",
    "images": "node node/optimize-images.js",
    "images:force": "node node/optimize-images.js --force",
    "wrap:pictures": "node node/wrap-pictures.js",
    "compress:hero": "node node/compress-hero-images.js",
    "dev": "http-server . -p 8080 -c-1 -e html --gzip",
    "dev:firefox": "concurrently -n server,browser \"http-server . -p 8080 -c-1 -e html --gzip\" \"wait-on http://127.0.0.1:8080 && start firefox http://127.0.0.1:8080/\"",
    "serve": "http-server . -p 8080 -c-1 -e html --gzip"
  },
  "author": "Sarka Simova",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "http-server": "^14.1.1",
    "sass": "^1.81.0",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.5"
  },
  "dependencies": {
    "@tailwindcss/cli": "^4.1.18",
    "braces": "^3.0.3",
    "detect-libc": "^1.0.3",
    "fill-range": "^7.1.1",
    "gsap": "^3.14.2",
    "immutable": "^5.0.3",
    "is-extglob": "^2.1.1",
    "is-glob": "^4.0.3",
    "is-number": "^7.0.0",
    "micromatch": "^4.0.8",
    "node-addon-api": "^7.1.1",
    "picomatch": "^2.3.1",
    "readdirp": "^4.0.2",
    "sharp": "^0.34.3",
    "source-map-js": "^1.2.1",
    "tailwindcss": "^4.1.18",
    "to-regex-range": "^5.0.1"
  },
  "keywords": [],
  "type": "commonjs"
}
